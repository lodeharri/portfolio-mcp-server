# .env.example — template for local development environment.
#
# Copy this file to `.env` and fill in your real values. The `.env`
# file is in `.gitignore` so it will never be committed.
#
# cp .env.example .env
# $EDITOR .env
# python -m mcp_server.interfaces.cli.preindex
#
# All variables are optional. The project uses mock-gemini when
# GEMINI_API_KEY is unset, so the system is fully functional without
# any of these (for development and demos).

# =============================================================================
# LLM / Embeddings (Google Gemini)
# =============================================================================

# Production: get a free key from Google AI Studio
#   https://aistudio.google.com/apikey
# Leave empty to use --mock-gemini (deterministic SHA-256 vectors).
GEMINI_API_KEY=

# Embedding model dimension. Default 768 for text-embedding-004.
# If you change the embedding model, change this too.
EMBEDDING_DIM=768

# =============================================================================
# Server runtime
# =============================================================================

# HTTP port the FastAPI / FastMCP server binds to.
# Platform-specific defaults:
#   - Fly.io: default 8080
#   - Hugging Face Spaces: default 7860
#   - Render: default 10000
PORT=8080

# Path to the projects manifest. The manifest is the SINGLE SOURCE OF
# TRUTH for which projects get indexed (Layer 1 security).
MANIFEST_PATH=config/projects.manifest.yaml

# Directory for the pre-baked vector index (data/index.sqlite).
DATA_DIR=data

# Log level. Standard Python logging levels.
LOG_LEVEL=INFO

# =============================================================================
# Build metadata (used by /healthz response)
# =============================================================================

# These are normally set at build time via Docker build args / CI env vars.
# Local dev: defaults are used (commit_sha=dev, version=0.1.0).

# COMMIT_SHA=dev
# BUILT_AT=2026-08-05T00:00:00Z
# VERSION=0.1.0
